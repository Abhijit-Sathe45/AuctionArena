PORT=5000
MONGO_URI=mongodb://localhost:27017/tennis_auction
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Razorpay (get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Cloudinary (for player photo / team logo uploads) https://cloudinary.com
CLOUDINARY_CLOUD_NAME=xxxxx
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx

# Super Admin bootstrap (used once on first server start to create the super admin)
SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

CLIENT_URL=http://localhost:5173
